{
  "name": "@agentic-media-kit/studio",
  "version": "1.0.0",
  "private": true,
  "description": "Brand-neutral Remotion template for Instagram Reels, feed posts, stories, stills and screen-capture tours.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render",
    "still": "remotion still",
    "reel": "remotion render Promo-Reel out/promo-reel.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "tour": "remotion render Tour-Reel out/tour-reel.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "cover": "remotion still Reel-Cover out/reel-cover.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.507",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.7.3"
  },
  "license": "MIT"
}
