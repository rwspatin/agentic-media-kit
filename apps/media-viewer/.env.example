# Copy to .env for local dev (never commit .env).

# --- Required ---
AUTH_PASSWORD=change-me                     # shared password for the web UI
SESSION_SECRET=generate-with-openssl-rand-hex-32
BUCKET_NAME=your-bucket-name
BUCKET_ENDPOINT=https://your-s3-endpoint.example.com
BUCKET_REGION=auto                          # "auto" for Railway buckets
BUCKET_ACCESS_KEY_ID=your-access-key-id
BUCKET_SECRET_ACCESS_KEY=your-secret-access-key

# --- Optional ---
UPLOAD_TOKEN=                               # enables `Authorization: Bearer <token>` on POST /upload (agents)
UNSORTED_PROJECT=unsorted                   # pseudo-project for files at the bucket root
APP_TITLE=Media Viewer
MAX_UPLOAD_MB=1024                          # upload size limit (files are buffered in memory)
BUCKET_FORCE_PATH_STYLE=false               # true for MinIO / some S3-compatible stores
COOKIE_SECURE=true                          # set false only for plain-http local dev
PORT=3000
